# AI Agent Factory — environment template. Copy to ".env" and adjust.
# AI provider keys DO go here (this file is the template — the real .env
# must NEVER be committed; this repository is PUBLIC). The n8n workflows
# read the keys from these environment variables at runtime, so no key
# value ever appears inside a workflow JSON file. See HUONG-DAN.md.

# --- PostgreSQL ---
POSTGRES_USER=aifactory
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=ai_factory
POSTGRES_PORT=5432

# --- Ports on the host ---
N8N_PORT=5678
CES_PORT=8080

# --- Code Execution Service sandbox ---
# docker = isolated containers (recommended). local = dev only, UNSAFE for
# untrusted code (no isolation at all).
SANDBOX_MODE=docker
SANDBOX_IMAGE=node:20-alpine

# Absolute path of the ./ces-data/workspaces folder ON THE HOST machine.
# Required in docker mode so sandbox containers mount the same files.
# Windows example: C:/ai-agent-factory/ces-data/workspaces
# macOS/Linux example: /home/you/ai-agent-factory/ces-data/workspaces
HOST_WORKSPACES_DIR=

# Public URL of the Code Execution Service (used in ZIP download links).
PUBLIC_CES_URL=http://localhost:8080

TIMEZONE=Asia/Ho_Chi_Minh

# --- AI provider keys (workflows read them via $env) ---
# Copy the values from your MindFlow backend .env (backend/.env in this
# repo's root). Leave a provider empty if you do not use it.
GROQ_API_KEY=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
