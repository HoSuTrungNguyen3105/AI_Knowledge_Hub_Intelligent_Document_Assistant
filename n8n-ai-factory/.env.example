# AI Agent Factory — environment template. Copy to ".env" and adjust.
# AI provider keys DO go here (this file is the template — the real .env
# must NEVER be committed; this repository is PUBLIC). The n8n workflows
# read the keys from these environment variables at runtime, so no key
# value ever appears inside a workflow JSON file. See HUONG-DAN.md.

# --- MongoDB Atlas (NO LONGER USED by this package) ---
# Factory data (projects, tasks, agent runs, QA reviews, artifacts) used to
# live in MongoDB Atlas — the same cluster as MindFlow — but the only
# consumer was the Code Execution Service, which has been REMOVED from
# this package. Nothing in docker-compose.yml reads MONGODB_URI anymore;
# the two variables below are kept only as a reference to that shared
# Atlas cluster and can be left empty.
# WARNING: the URI contains your database PASSWORD. The real .env must
# NEVER be committed (this repository is PUBLIC).
MONGODB_URI=
MONGODB_DATABASE=mindflow_ai

# --- Ports on the host ---
N8N_PORT=5678

# --- Code Execution Service: REMOVED ---
# The CES (Dashboard + sandboxed file/build/ZIP service on port 8080) has
# been removed from this package, so its old variables (CES_PORT,
# SANDBOX_MODE, SANDBOX_IMAGE, HOST_WORKSPACES_DIR, PUBLIC_CES_URL) are
# gone too. The compose file now runs n8n only.

TIMEZONE=Asia/Ho_Chi_Minh

# --- AI provider keys (workflows read them via $env) ---
# Copy the values from your MindFlow backend .env (backend/.env in this
# repo's root). Leave a provider empty if you do not use it.
GROQ_API_KEY=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=

# --- Optional: Telegram notifications ---
# Used by workflow 07 (notify when a team run finishes) and workflow 08
# (weekly research digest). Create a bot via @BotFather, send it any
# message once, then read your chat id from
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# Leave both empty to disable notifications entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
