{
  "name": "AI Factory — ZIP Packaging",
  "nodes": [
    {
      "parameters": {
        "content": "## ZIP Packaging\nInput: {project_id}. Asks the Code Execution Service to zip the project workspace (node_modules, .git and .env files are always excluded), stores the download URL on the project and returns it.",
        "height": 180,
        "width": 560,
        "color": 4
      },
      "id": "97b095b8-ceb3-4d2d-9ef7-566bcbd42453",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-factory/package",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "fdf7d6bf-25a6-4fe7-843e-8a01b7751a13",
      "name": "Webhook — Package",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        320
      ],
      "webhookId": "beecd0ea-cd40-4a41-a8f8-1063d6da5870"
    },
    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\nconst body = input.body ?? input;\nconst cesBase = ($env.CODE_EXEC_URL || 'http://code-exec-service:8080').replace(/\\/$/, '');\nreturn [{ json: {\n  project_id: body.project_id,\n  ces_url: `${cesBase}/projects/${body.project_id}/package`,\n  ces_body: {}\n} }];\n"
      },
      "id": "fe7c903d-7bc2-4957-889a-16d667b58255",
      "name": "Prepare Package",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.ces_url }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.ces_body) }}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "83bbf50a-7c6d-4817-83e3-f47c756b88b8",
      "name": "Package ZIP (CES)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst prep = $('Prepare Package').first().json;\nconst pkg = $input.first().json;\nconst project_update = { project_id: prep.project_id, set: { zip_url: pkg.download_url || null } };\nreturn [{ json: {\n  project_update,\n  response: {\n    project_id: prep.project_id,\n    download_url: pkg.download_url || null,\n    file_count: pkg.file_count ?? null,\n    size_bytes: pkg.size_bytes ?? null\n  }\n} }];\n"
      },
      "id": "097f6007-4389-4ad0-8a9b-dc19ea013498",
      "name": "Build Project Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.CODE_EXEC_URL || 'http://code-exec-service:8080') + '/db/projects/update' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.project_update) }}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "5d56c0b6-8ffd-4133-b18c-52cb8d739b0a",
      "name": "Update Project (CES)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Build Project Update').first().json.response) }}",
        "options": {}
      },
      "id": "1735178b-163f-4bae-bf06-6428522e359a",
      "name": "Respond — Package Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1540,
        320
      ]
    }
  ],
  "connections": {
    "Webhook — Package": {
      "main": [
        [
          {
            "node": "Prepare Package",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Package": {
      "main": [
        [
          {
            "node": "Package ZIP (CES)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Package ZIP (CES)": {
      "main": [
        [
          {
            "node": "Build Project Update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Project Update": {
      "main": [
        [
          {
            "node": "Update Project (CES)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Project (CES)": {
      "main": [
        [
          {
            "node": "Respond — Package Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}