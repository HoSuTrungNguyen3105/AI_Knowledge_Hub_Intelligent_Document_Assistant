{
  "name": "AI Factory — ZIP Packaging",
  "nodes": [
    {
      "parameters": {
        "content": "## ZIP Packaging\nInput: {project_id}. Asks the Code Execution Service to zip the project workspace (node_modules, .git and .env files are always excluded), stores the download URL on the project and returns it.",
        "height": 180,
        "width": 560,
        "color": 4
      },
      "id": "86d32fa2-b948-4194-a093-fb2b0dc5fbf9",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-factory/package",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "9408c84e-7434-40c0-afb2-cf1ae3c83711",
      "name": "Webhook — Package",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        320
      ],
      "webhookId": "72699899-5271-46df-9aa2-1c414daf3b59"
    },
    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\nconst body = input.body ?? input;\nconst cesBase = ($env.CODE_EXEC_URL || 'http://code-exec-service:8080').replace(/\\/$/, '');\nreturn [{ json: {\n  project_id: body.project_id,\n  ces_url: `${cesBase}/projects/${body.project_id}/package`,\n  ces_body: {}\n} }];\n"
      },
      "id": "3b08b6fc-7122-456f-afbf-55e4f8f5335e",
      "name": "Prepare Package",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.ces_url }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.ces_body) }}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "3c8c8e4c-1eee-4015-981b-1c9fcf2e2c43",
      "name": "Package ZIP (CES)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst esc = (v) => (v === null || v === undefined) ? 'NULL' : `'${String(v).replace(/'/g, \"''\")}'`;\nconst escJson = (v) => (v === null || v === undefined) ? 'NULL' : `'${JSON.stringify(v).replace(/'/g, \"''\")}'::jsonb`;\n\nconst prep = $('Prepare Package').first().json;\nconst pkg = $input.first().json;\nconst sql = `UPDATE projects SET zip_url=${esc(pkg.download_url || null)}, updated_at=now() WHERE id=${esc(prep.project_id)}::uuid`;\nreturn [{ json: {\n  sql,\n  response: {\n    project_id: prep.project_id,\n    download_url: pkg.download_url || null,\n    file_count: pkg.file_count ?? null,\n    size_bytes: pkg.size_bytes ?? null\n  }\n} }];\n"
      },
      "id": "6121dfe8-f73b-4aef-ad16-0444261e417d",
      "name": "Build Project Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        320
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}",
        "options": {}
      },
      "id": "b82d6071-ac6e-4edf-9259-ddb44fd16c3d",
      "name": "Update Project (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1280,
        320
      ],
      "credentials": {
        "postgres": {
          "id": null,
          "name": "AI Factory Postgres"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Build Project Update').first().json.response) }}",
        "options": {}
      },
      "id": "e71bad13-835b-4a58-9be0-983e5da9e629",
      "name": "Respond — Package Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1540,
        320
      ]
    }
  ],
