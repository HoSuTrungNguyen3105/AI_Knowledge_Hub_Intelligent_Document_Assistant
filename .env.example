# Run: python scripts/init_env.py (creates .env with random local secrets)
POSTGRES_USER=knowledgehub
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=knowledgehub
DATABASE_URL=postgresql+psycopg://knowledgehub:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/knowledgehub
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
# Independent Fernet key: keep it backed up with the DB, never rotate by regenerating .env.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_FERNET_ENCRYPTION_KEY
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Reserved for later AI phases; never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
GEMINI_API_KEY=
