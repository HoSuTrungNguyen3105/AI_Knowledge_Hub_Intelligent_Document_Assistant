# Run: python scripts/init_env.py  (creates backend/.env with random local secrets)
# MongoDB: local server (mongodb://localhost:27017) or MongoDB Atlas (mongodb+srv://...).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mindflow_ai
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
# Independent Fernet key: back it up with the database; never rotate by regenerating .env.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_FERNET_ENCRYPTION_KEY
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_RATE_LIMIT=120
AUTH_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# Provider API keys (OpenAI/Gemini) are entered per user in /settings and stored
# encrypted in MongoDB. Do NOT put real provider keys here or use NEXT_PUBLIC_.