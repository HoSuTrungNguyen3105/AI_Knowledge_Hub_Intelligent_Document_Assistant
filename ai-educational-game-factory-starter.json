        "jsCode": "const cfg = $('Factory Configuration').first().json;\\nconst repo = $input.first().json;\\nif (repo.message || !repo.full_name) {\\n  throw new Error(`Cannot read GitHub repository: ${repo.message || 'Unexpected response'}`);\\n}\\nreturn [{ json: {\\n  ...cfg,\\n  repository: { fullName: repo.full_name, defaultBranch: repo.default_branch, htmlUrl: repo.html_url, description: repo.description },\\n  runStartedAt: new Date().toISOString(),\\n  nextStep: 'Inspect repository files and game registry before generating any code.'\\n}}];"
